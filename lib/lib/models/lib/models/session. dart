import 'package:hive/hive.dart';

@HiveType(typeId: 1)
class Session extends HiveObject {
  @HiveField(0) DateTime startedAt;
  @HiveField(1) int durationMinutes;

  Session({required this.startedAt, required this.durationMinutes});
}

class SessionAdapter extends TypeAdapter<Session> {
  @override final int typeId = 1;
  @override
  Session read(BinaryReader reader) => Session(
        startedAt: DateTime.fromMillisecondsSinceEpoch(reader.readInt()),
        durationMinutes: reader.readInt(),
      );
  @override
  void write(BinaryWriter writer, Session obj) {
    writer.writeInt(obj.startedAt.millisecondsSinceEpoch);
    writer.writeInt(obj.durationMinutes);
  }
}
